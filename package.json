{
  "name": "basket-wise",
  "version": "0.4.0",
  "private": true,
  "description": "A personal supermarket basket and expiry tracker for ChatGPT.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run build:ui && tsc -p tsconfig.build.json && node scripts/validate-plugin.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "start": "node dist/main.js",
    "start:stdio": "node dist/main.js --stdio",
    "preview": "vite --host 127.0.0.1",
    "preview:built": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke && npm run smoke:guest",
    "check:public": "node scripts/check-public-readiness.mjs",
    "dev:guest": "wrangler dev",
    "check:guest": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy:guest": "wrangler deploy",
    "smoke:guest": "node scripts/smoke-guest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  }
}
